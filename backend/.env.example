APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=energy_dashboard
DB_USERNAME=root
DB_PASSWORD=

# Admin account created by `php artisan db:seed`. Replace these placeholders
# with your own values. The seeder aborts if either is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret used to sign JWT tokens (`tymon/jwt-auth`). Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# Replace this placeholder with your own value.
JWT_SECRET=

# Comma-separated list of origins allowed by the CORS middleware.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MQTT subscriber (`php artisan mqtt:subscribe`)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=laravel_subscriber
MQTT_TOPIC=sensors/temperature
MQTT_USER=
MQTT_PASS=
MQTT_KEEP_ALIVE=10

# Path to the chatbot keyword dataset (JSON). Defaults to backend/dataset/.
# CHATBOT_DATASET=backend/dataset/chatbot_dataset.json